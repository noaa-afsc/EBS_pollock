mutate(norm_value = value / key_value)
?right_join
#unique(all_ts$type) (all_ts) |> group_by(source, type) |> summarise(mean(value))
all_ts
#unique(all_ts$type) (all_ts) |> group_by(source, type) |> summarise(mean(value))
Plot_rel_SSB <- function(df = all_ts, key="pm") {
df1 <- df |> filter(type == "SSB", Year < 2025, Year > 1963,
source == "key") |>
select(year, key_value = value)
# Join back to all rows
p1 <- df1 |> right_join(df, by = "year") %>%
# Normalize value by key_value
mutate(norm_value = value / key_value) |>
ggplot(aes( x = Year,
y = norm_value, fill = source )) +
geom_line(stat = "identity") +
geom_point(stat = "identity") +
geom_ribbon(alpha=.29) +
ggthemes::theme_few() +
ylab("SSB") +
xlab("Year") +
ylim(0, NA) +
facet_grid(type ~ ., scales = "free_y")
return(p1)
}
